<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scroll content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSave">

        <LinearLayout
            android:id="@+id/addfoodlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <!-- Title -->
            <TextView
                android:id="@+id/txtAddItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Item"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp" />

            <!-- Name -->
            <EditText
                android:id="@+id/edtFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Food Name"
                android:padding="12dp" />

            <!-- Description -->
            <EditText
                android:id="@+id/edtFoodDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Short Description"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Category -->
            <EditText
                android:id="@+id/edtFoodCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Guide -->
            <EditText
                android:id="@+id/edtFoodGuide"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:hint="Cooking Guide"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:scrollbars="vertical" />

            <!-- Image -->
            <ImageView
                android:id="@+id/imgSelected"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_lunch"
                android:layout_marginTop="12dp" />

            <!-- Image + Manage buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="start">

                <Button
                    android:id="@+id/btnSelectImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Image" />

                <Button
                    android:id="@+id/btnManageIngredients"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Manage Ingredients" />
            </LinearLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/edtSearchIngredient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search ingredients..."
                android:drawableLeft="@drawable/ic_search"
                android:padding="12dp"
                android:layout_marginTop="12dp" />

            <!-- Ingredient list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerIngredientSelect"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />

            <!-- Summary text -->
            <TextView
                android:id="@+id/txtSelectedIngredientsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Ingredients:"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Save button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Recipe"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

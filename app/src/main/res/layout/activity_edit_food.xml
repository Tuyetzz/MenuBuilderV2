<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chỉnh sửa món ăn"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu"
                android:textColor="@android:color/white"
                android:background="@drawable/custom_button_background" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên món ăn"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border" />

        <EditText
            android:id="@+id/edtFoodCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Danh mục"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border" />

        <EditText
            android:id="@+id/edtFoodDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border" />

        <EditText
            android:id="@+id/edtFoodGuide"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Hướng dẫn nấu"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/edtFoodImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL ảnh"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border" />

        <ImageView
            android:id="@+id/imgFoodPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_lunch"
            android:layout_marginBottom="16dp" />

        <!-- Ingredients Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nguyên liệu"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEditIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <Button
                android:id="@+id/btnAddIngredient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Thêm nguyên liệu"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_button_background"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>